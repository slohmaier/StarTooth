  </data>
  <data name="Dialog.ListName" xml:space="preserve">
    <value>Paired devices</value>
  </data>
  <data name="Dialog.ListDescription" xml:space="preserve">
    <value>List of all paired Bluetooth devices. Checked devices appear at the top of the menu as favorites.</value>
  </data>
  <data name="Dialog.Ok" xml:space="preserve">
    <value>OK</value>
    <comment>No access key: this is the default button, reached with Enter.</comment>
  </data>
