  <data name="Menu.NoDevices" xml:space="preserve">
    <value>No paired devices found</value>
    <comment>Shown instead of the device list when nothing is paired.</comment>
  </data>
  <data name="Menu.OtherDevices" xml:space="preserve">
    <value>Other devices</value>
    <comment>Heading above the non-starred devices. Only shown once a favorite exists.</comment>
  </data>
  <data name="Menu.ManageFavorites" xml:space="preserve">
    <value>&amp;Manage Favorites…</value>
    <comment>Opens the favorites dialog. The ampersand marks the access key.</comment>
  </data>
  <data name="Menu.Refresh" xml:space="preserve">
    <value>&amp;Refresh</value>
  </data>
  <data name="Menu.Exit" xml:space="preserve">
    <value>E&amp;xit</value>
    <comment>Quits the application. "Exit" is the Windows convention for tray apps.</comment>
  </data>

  <data name="State.Connected" xml:space="preserve">
    <value>Connected</value>
    <comment>Matches the wording of the Windows Bluetooth settings page.</comment>
  </data>
  <data name="State.NotConnected" xml:space="preserve">
    <value>Not connected</value>
    <comment>Matches the wording of the Windows Bluetooth settings page.</comment>
  </data>

  <data name="Device.Accessible.Favorite" xml:space="preserve">
    <value>{0}, favorite, {1}</value>
    <comment>Screen reader name. {0} device name, {1} connection state.</comment>
  </data>
  <data name="Device.Accessible.Plain" xml:space="preserve">
    <value>{0}, {1}</value>
    <comment>Screen reader name. {0} device name, {1} connection state.</comment>
  </data>
  <data name="Device.Accessible.ActionConnect" xml:space="preserve">
    <value>Activating connects this device.</value>
  </data>
  <data name="Device.Accessible.ActionDisconnect" xml:space="preserve">
    <value>Activating disconnects this device.</value>
  </data>
  <data name="Device.Tooltip" xml:space="preserve">
    <value>{0} · {1}</value>
    <comment>{0} Bluetooth address, {1} connection state.</comment>
  </data>

  <data name="Tray.Connecting" xml:space="preserve">
    <value>StarTooth – connecting {0}…</value>
    <comment>Tray tooltip. Windows truncates this at 63 characters.</comment>
  </data>
  <data name="Tray.Disconnecting" xml:space="preserve">
    <value>StarTooth – disconnecting {0}…</value>
    <comment>Tray tooltip. Windows truncates this at 63 characters.</comment>
  </data>

  <data name="Error.ConnectTitle" xml:space="preserve">
    <value>Connection failed</value>
  </data>
  <data name="Error.DisconnectTitle" xml:space="preserve">
    <value>Disconnect failed</value>
  </data>
  <data name="Error.Balloon" xml:space="preserve">
